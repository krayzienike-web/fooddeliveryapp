{
  "expo": {
    "name": "ЖАР",
    "slug": "zhar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A120D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ru.zhar.demo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-image",
      "expo-video",
      "expo-font",
      "expo-speech-recognition",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "ЖАР использует камеру, чтобы показать блюдо на вашем столе в натуральную величину и отсканировать QR на столе в ресторане.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "zhar",
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "eas": {
        "projectId": "e2356c26-b39c-4930-ab86-2fffef40a641"
      }
    },
    "owner": "krayzienike"
  }
}
