# Android build: «Шеф ИИ» talks to the proxy in server/ai-proxy (the Claude API key lives there, never in the app).
EXPO_PUBLIC_AI_PROXY_URL=https://zhar-ai-proxy.<your-subdomain>.workers.dev
# Must match the proxy's APP_KEY secret. Not a real secret (it ships in the app) — it only filters casual traffic.
EXPO_PUBLIC_AI_APP_KEY=
